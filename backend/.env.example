# Copy this file to .env and fill in your own values. Never commit .env.

# --- MySQL ---
MYSQL_USER=grocery_user
MYSQL_PASSWORD=change_me
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=smart_grocery
# Or give a full SQLAlchemy URL instead (overrides the values above):
# DATABASE_URL=mysql+pymysql://grocery_user:change_me@localhost:3306/smart_grocery?charset=utf8mb4

# --- Secrets: use long random strings (at least 32 characters) ---
# PowerShell: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-long-random-string
JWT_SECRET_KEY=replace-with-another-long-random-string

# --- Auth cookie settings ---
JWT_EXPIRES_HOURS=8
# Local development over http://localhost: False. Production over HTTPS: True.
JWT_COOKIE_SECURE=False
JWT_COOKIE_SAMESITE=Lax

# Frontend address allowed by CORS
FRONTEND_ORIGIN=http://localhost:5173

# Login/register attempts per IP
AUTH_RATE_LIMIT=10 per minute

# Prediction history window (number of 30-day periods to average)
PREDICTION_HISTORY_PERIODS=3

FLASK_DEBUG=False

# Optional: run tests against a MySQL test database instead of in-memory SQLite
# TEST_DATABASE_URL=mysql+pymysql://grocery_user:change_me@localhost:3306/smart_grocery_test?charset=utf8mb4
